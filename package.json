    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@types/bun": "1.2.21",
    "@cloudflare/workers-types": "5.20260922.1",
    "typescript": "5.8.2",
    "wrangler": "4.136.1"
  }
}
